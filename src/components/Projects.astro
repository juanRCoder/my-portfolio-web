---
import { Image } from "astro:assets";

const CaveFlow = "/images/CaveFlow.png";
const Crewland = "/images/Crewland.png";
const CVinter = "/images/CVinter.png";

const projects = [
  {
    title: "CaveFlow",
    description:
      "Sistema de pedidos para pequeños restaurantes, asistencia en la gestión de pedidos y control de inventario.",
    techs: ["REACT", "NESTJS", "POSTGRESQL"],
    image: CaveFlow,
    link: "https://landing-caveflow.netlify.app/",
  },
  {
    title: "Crewland",
    description:
      "Plataforma de eventos para alquiler de vivienda y transporte de fanáticos musicales a giras.",
    techs: ["NEXT", "NESTJS", "POSTGRESQL"],
    image: Crewland,
    link: "https://event-crew-vibes.lovable.app/",
  },
  {
    title: "CVinter",
    description:
      "Generador de CVs en tiempo real con conversión usando html2canvas.",
    techs: ["REACT", "TYPESCRIPT", "TAILWINDCSS"],
    image: CVinter,
    link: "https://i002-cvinter-front-phi.vercel.app/",
  },
];
---

<article id="projects" class="container mx-auto max-w-6xl text-white py-20 px-4">
  <section class="w-full flex flex-col gap-12">
    <div class="section-header">
      <h3>PROYECTOS DESTACADOS</h3>
      <div class="section-line"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        projects.map((project, i) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card group flex flex-col no-underline rounded-xl overflow-hidden transition-all duration-400"
          >
            <div class="project-card-inner flex flex-col rounded-xl overflow-hidden border border-white/4 h-full">
              <div class="relative h-44 overflow-hidden bg-white/2">
                <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <Image
                  class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  src={project.image}
                  alt={`photo_${project.title}`}
                  loading="eager"
                  width={500}
                  height={300}
                />
                <div class="absolute top-3 left-3 z-20">
                  <span class="text-[10px] font-mono text-white/30 tracking-widest bg-black/30 backdrop-blur-sm px-2 py-0.5 rounded">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 z-20 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-1 group-hover:translate-y-0">
                  <span class="text-[9px] font-medium tracking-wider uppercase text-white/70 bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-full">
                    Ver proyecto
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2.5 p-4 flex-1">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-semibold text-white/90 tracking-tight group-hover:text-white transition-colors duration-300">
                    {project.title}
                  </h4>
                  <svg
                    class="w-3.5 h-3.5 text-white/15 group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 17L17 7M17 7H7M17 7v10"
                    />
                  </svg>
                </div>

                <p class="text-text-muted text-xs leading-relaxed line-clamp-2">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-1.5 pt-1 mt-auto">
                  {project.techs.map((tech) => (
                    <span class="text-[9px] text-white/30 tracking-wider font-medium uppercase">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</article>

<style>
  .project-card-inner {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.02) 0%,
      rgba(255, 255, 255, 0.005) 100%
    );
    transition: all 0.4s ease;
  }

  .project-card:hover .project-card-inner {
    border-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
  }
</style>
