---
const experiences = [
  {
    role: "Full Stack Developer",
    project: "Scheduler Module",
    company: "CT Developers",
    modality: "Remoto",
    period: "Febrero 2025 - Enero 2026",
    companyDescription:
      "Empresa de desarrollo de software que brinda soluciones tecnológicas a empresas de EE. UU.",
    highlights: [
      "Desarrollo integral de una plataforma de turnos que maneja la asociación de rutas, vehículos y tipos de paquetes. Reconstruí un sistema de turnos lento (v2) migrándolo a una nueva arquitectura (v3) que optimizó los tiempos de respuesta y simplificó la experiencia del usuario.",
    ],
  },
];
---

<article
  id="experiences"
  class="container mx-auto max-w-6xl flex items-center justify-evenly gap-10 text-white py-20 px-4"
>
  <section class="w-full flex flex-col gap-8">
    <div class="section-header">
      <h3>EXPERIENCIA LABORAL</h3>
      <div class="section-line"></div>
    </div>

    <div class="relative pl-8">
      <div class="timeline-line"></div>

      {experiences.map(({ role, project, company, modality, period, companyDescription, highlights }) => (
        <div class="relative pb-10 last:pb-0">
          <div class="timeline-dot"></div>

          <div class="ml-6">
            <div class="flex items-start justify-between gap-4 flex-wrap mb-1">
              <div>
                <h4 class="text-text-primary text-base font-semibold">{role}</h4>
                <p class="text-accent-blue text-sm mt-0.5">{project}</p>
              </div>
              <span class="inline-block px-3 py-1 rounded bg-accent-purple/10 text-accent-purple text-[11px] tracking-wide font-medium whitespace-nowrap">
                {period}
              </span>
            </div>

            <p class="text-text-secondary text-sm mt-1">
              {company} <span class="text-text-muted">· {modality}</span>
            </p>
            <p class="text-text-muted text-xs mt-1 italic">
              {companyDescription}
            </p>

            <ul class="mt-4 space-y-2">
              {highlights.map((item) => (
                <li class="flex gap-3 text-text-secondary text-sm leading-relaxed">
                  <span class="text-accent-cyan mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-accent-cyan/40" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
</article>
