---
const skillGroups = [
  {
    title: "Front End",
    color: "#ADC6FF",
    icon: `<rect x="2" y="4" width="14" height="10" rx="1.5"></rect>
           <path d="M9 14v3"></path>
           <path d="M6 20h6"></path>
           <rect x="17" y="9" width="5" height="8" rx="1"></rect>`,
    skills: [
      "html5/css3",
      "typescript",
      "react",
      "next",
      "vue 3",
      "storybook",
      "shadcn/ui",
      "tailwindcss",
    ],
  },
  {
    title: "Back End",
    color: "#D0BCFF",
    icon: `<rect x="2" y="3" width="20" height="8" rx="2"></rect>
           <rect x="2" y="13" width="20" height="8" rx="2"></rect>
           <line x1="6" y1="7" x2="6.01" y2="7"></line>
           <line x1="6" y1="17" x2="6.01" y2="17"></line>`,
    skills: ["node", "express", "nestjs", "sequelize", "prisma", "java", "spring boot", "maven"],
  },
  {
    title: "Databases",
    color: "#4CD7F6",
    icon: `<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
           <path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path>
           <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"></path>`,
    skills: ["mysql", "postgresql", "supabase"],
  },
  {
    title: "DevOps e Infra",
    color: "#FFB4AB",
    icon: `<path d="M17.5 19a4.5 4.5 0 0 0 0-9 5.5 5.5 0 0 0-10.6-1.5A4.5 4.5 0 0 0 6.5 19h11z"></path>
           <path d="m9 12.5 2 2 4-4"></path>`,
    skills: ["docker", "git", "github actions", "render", "netlify"],
  },
  {
    title: "Inteligencia Artificial",
    color: "#C084FC",
    icon: `<path d="M12 2a4 4 0 0 1 4 4c0 1.95-1.4 3.58-3.25 3.93"></path>
           <path d="M8.25 9.93A4 4 0 0 1 8 6a4 4 0 0 1 8 0"></path>
           <path d="M12 18v4"></path>
           <path d="M8 22h8"></path>
           <circle cx="12" cy="6" r="2"></circle>`,
    skills: ["opencode", "claude web", "agents/skills", "prompt engineering"],
  },
  {
    title: "Testing",
    color: "#34D399",
    icon: `<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
           <polyline points="14 2 14 8 20 8"></polyline>
           <path d="m9 15 2 2 4-4"></path>`,
    skills: ["jest", "vitest"],
  },
];
---

<article
  id="skills"
  class="container mx-auto max-w-6xl flex items-center justify-evenly gap-10 text-white py-20 px-4"
>
  <section class="w-full flex flex-col gap-8">
    <div class="section-header">
      <h3>TECNOLOGIAS</h3>
      <div class="section-line"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {skillGroups.map(({ title, color, icon, skills }) => (
        <div class="card-base p-5 cursor-default bg-white/2">
          <div class="flex items-center gap-3.5 mb-5">
            <div
              class="w-10 h-10 flex items-center justify-center rounded"
              style={{ backgroundColor: `${color}15` }}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                style={{ color }}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icon}
              />
            </div>
            <h3 class="text-text-primary text-sm font-medium">{title}</h3>
          </div>

          <div class="flex flex-wrap gap-2">
            {skills.map((tech) => (
              <span
                class="px-2.5 py-1 rounded border text-[10px] tracking-wide font-mono uppercase"
                style={{
                  borderColor: `${color}20`,
                  color: `${color}CC`,
                }}
              >
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</article>
