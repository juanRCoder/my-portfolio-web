---
const coreStack = ["React", "NestJS", "TypeScript", "PostgreSQL"];
const socialLinks = [
  {
    name: "GitHub",
    href: "https://github.com/juanRCoder",
    path: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/juan-ramirez-developer/",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
  },
  {
    name: "CV",
    href: "https://drive.google.com/file/d/1PMPL28QaFxUq-dLnPG1o6HzmOpVslrHR/view?usp=sharing",
    path: "M6 2h8l6 6v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8 1v5h5",
  },
];
---

<section
  class="relative min-h-[60vh] flex flex-col justify-center items-center text-center px-8 md:px-16 lg:px-24 pt-28 pb-20"
  id="hero"
>
  {/* Status Badge */}
  <div class="hero-badge group cursor-default">
    <span class="hero-badge-dot"></span>
    <span class="hero-badge-text">Abierto a trabajar</span>
  </div>

  {/* Name */}
  <h1 class="hero-name mt-6 flex flex-row gap-2">
    <span class="hero-name-line">Juan</span>
    <span class="hero-name-line hero-name-accent">Ramirez</span>
  </h1>

  {/* Role Tagline */}
  <div class="hero-role mt-4">
    <span class="hero-role-line"></span>
    <h2 class="hero-role-text">
      Full Stack Developer
      <span class="hero-role-separator">·</span>
      <span class="hero-role-focus">Backend & APIs</span>
    </h2>
  </div>

  {/* Description */}
  <p class="hero-desc mt-6 max-w-lg">
    Diseño y construyo la arquitectura completa de productos digitales.
    Desde la lógica del servidor hasta la interfaz que toca el usuario.
  </p>

  {/* Tech Stack */}
  <div class="hero-stack mt-8">
    <span class="hero-stack-label">Stack principal</span>
    <div class="hero-stack-items flex flex-wrap gap-2.5">
      {coreStack.map((tech) => (
        <span class="hero-tech">{tech}</span>
      ))}
    </div>
  </div>

  {/* Social Links */}
  <div class="hero-social mt-10">
    {socialLinks.map((social) => (
      <a
        class="hero-social-link"
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d={social.path}></path>
        </svg>
        <span>{social.name}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(77, 215, 246, 0.1);
    background: rgba(77, 215, 246, 0.02);
    border-radius: 100px;
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .hero-badge:hover {
    border-color: rgba(77, 215, 246, 0.2);
    background: rgba(77, 215, 246, 0.04);
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-cyan);
    opacity: 0.7;
    animation: pulse-cyan 2s ease-in-out infinite;
  }

  @keyframes pulse-cyan {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .hero-badge-text {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-cyan);
    opacity: 0.8;
  }

  .hero-name {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 200;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.92);
    position: relative;
    z-index: 2;
  }

  .hero-name-line {
    display: block;
  }

  .hero-name-accent {
    font-weight: 600;
    background: linear-gradient(135deg, var(--color-accent-cyan), var(--color-accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .hero-role-line {
    width: 2rem;
    height: 1px;
    background: var(--color-accent-cyan);
    opacity: 0.3;
    display: none;
  }

  .hero-role-text {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .hero-role-separator {
    margin: 0 0.5rem;
    opacity: 0.3;
  }

  .hero-role-focus {
    color: var(--color-accent-cyan);
    opacity: 0.7;
  }

  .hero-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    opacity: 0.7;
    position: relative;
    z-index: 2;
  }

  .hero-stack {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .hero-stack-label {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .hero-stack-items {
    display: flex;
    gap: 0.5rem;
  }

  .hero-tech {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 100px;
    transition: all 0.3s ease;
  }

  .hero-tech:hover {
    border-color: rgba(77, 215, 246, 0.15);
    color: var(--color-accent-cyan);
    opacity: 0.8;
  }

  .hero-social {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .hero-social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .hero-social-link:hover {
    color: var(--color-accent-cyan);
  }

  .hero-social-link svg {
    width: 14px;
    height: 14px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .hero-social-link:hover svg {
    opacity: 0.8;
  }
  @keyframes scroll-hint {
    0%, 100% { opacity: 0.2; height: 3rem; }
    50% { opacity: 0.4; height: 3.5rem; }
  }

</style>
